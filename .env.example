# copy to .env and edit. .env is gitignored and auto-loaded by config.py.
# every var below is also a default in config.py — only set the ones you need to change.
# $REFS to earlier vars are expanded, and inline # comments are stripped.

# --- reservoirs (downloaded separately) + the search binaries ---
RESERVOIR=seq                                    # what to sample + leakage-check: seq (uniref90) | struct (pdb) | both (union graph)
UNIREF_FASTA=./uniref/uniref90.fasta.gz          # sequence reservoir: the gzipped uniref90 fasta (RESERVOIR=seq|both)
PDB_DIR=./data/pdb                               # structure reservoir: a directory of pdb/mmcif files (RESERVOIR=struct|both, see download_pdb.sh)
MMSEQS=mmseqs                                    # mmseqs2 binary (use a gpu build to enable GPU=1)
FOLDSEEK=foldseek                                # path to the foldseek binary (not on brew: github releases -> untar -> bin/foldseek; gpu build to enable GPU=1)
GPU=                                             # set GPU=1 (+ gpu mmseqs/foldseek builds) to run the leakage check on a cuda gpu

# --- outputs / scratch ---
TRAINSET=./trainset.fasta                        # generated leakage-free training set (fasta keyed by uniprot code)
WORK=/tmp/mmseqs_work                            # mmseqs scratch (ephemeral, safe to delete)
# FORMATTED_DIR=./data/formatted                 # where fastas.py writes the benchmark fastas (default shown)

# --- leakage rule + search (homology.py reuses these to re-split a benchmark) ---
THREADS=8                                        # mmseqs/foldseek threads
SENS=7.5                                         # mmseqs sensitivity (higher finds more remote homologs)
COV=0.8                                          # min coverage to call it sequence leakage
COV_MODE=union                                   # union (default) = both 1 and 2, so subdomains are caught either way; or 1 = cover the test seq, 2 = the train seq, 0 = both
MIN_ID=0.2                                       # min identity to a test seq to call it sequence leakage (>20%)
TM=0.5                                           # min foldseek TM-score to a test structure to call it structural leakage (>0.5 = same fold)
# STRUCT_TESTS=./data/structs                    # dir of test-set structures for the foldseek check (default shown)
# SPLITS_DIR=./data/splits                       # where homology splits are cached, one file per benchmark per threshold (default shown)
# SIFTS=./data/sifts/uniprot_segments_observed.csv.gz   # pdb -> uniprot residue numbering table, used by the allosteric benchmarks (default shown)

# --- sampling ---
QUOTA=1000000                                    # how many leakage-free sequences to collect
OVERSAMPLE=1.5                                   # sample this multiple of the shortfall each round (covers dropped leakers)
MIN_LEN=20                                       # only sample proteins at least this long
MAX_LEN=1000                                     # ..and at most this long (drops fragments + giant non-physiological seqs)
SEED=0                                           # rng seed for sampling
